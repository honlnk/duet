{
  "name": "@honlnk/duet",
  "version": "1.0.0",
  "description": "Duet — 多智能体自主对话聊天室（终端用户可 npx 运行）",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "duet-chat": "dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "keywords": [
    "duet",
    "ai",
    "chat",
    "deepseek",
    "multi-agent",
    "conversation"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test",
    "prepublishOnly": "pnpm -w build"
  },
  "dependencies": {
    "fastify": "^5.10.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
