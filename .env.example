# ─────────────────────────────────────────────────────────────
# Duet 环境变量（均为可选，无必填项）
#
# 说明：API Key、模型、Base URL、价格等凭证不在环境变量中配置，
# 启动后通过页面「Provider」面板维护（支持 OpenAI 兼容 /
# Responses / Anthropic / Gemini 四种协议），落盘到
# 数据目录下的 providers.json。
# ─────────────────────────────────────────────────────────────

# 服务端口（0 = 自动分配可用端口）
PORT=23892

# 数据根目录（sessions/、providers.json、library.json 均在其下）
# 留空时的默认值：
# - npm 包（npx / 全局安装）：~/.duet（与 npx 缓存隔离，配置不丢）
# - 源码开发：项目根/data
# Docker 镜像内默认为 /data；自部署也可显式指定（需有写权限）
# DATA_DIR=/data

# 全局硬熔断（防止无限对话烧钱；会话级 maxRounds/durationSec 留空=无限，但仍受此兜底）
ABSOLUTE_MAX_ROUNDS=200
ABSOLUTE_MAX_DURATION_SEC=7200

# 单次 AI 调用超时（毫秒）
REQUEST_TIMEOUT_MS=30000
