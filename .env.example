# 服务端口（0 = 自动分配可用端口）
PORT=3000

# 会话数据持久化目录
# - 开发 / 源码部署：留空则使用 项目根/data/sessions
# - npm 包 / Docker：建议显式指定，避免数据写到包目录或容器临时层
# Docker 镜像内默认为 /data，npm 包用户可设为 ~/.duet 等
# DATA_DIR=/data

# 全局硬熔断（防止无限对话烧钱）
ABSOLUTE_MAX_ROUNDS=200
ABSOLUTE_MAX_DURATION_SEC=7200

# 单次 AI 调用超时（毫秒）
REQUEST_TIMEOUT_MS=30000
