# ─────────────────────────────────────────────────────────────
# Duet 环境变量（均为可选，无必填项）
#
# 说明：API Key、模型、Base URL、价格等凭证不在环境变量中配置，
# 启动后通过页面右上角「Provider」面板维护（支持 OpenAI 兼容 /
# Responses / Anthropic / Gemini 四种协议），落盘到
# DATA_DIR 的父目录下 providers.json。
# ─────────────────────────────────────────────────────────────

# 服务端口（0 = 自动分配可用端口）
PORT=3000

# 会话数据持久化目录
# - 开发 / 源码部署：留空则使用 项目根/data/sessions
# - npm 包 / Docker：建议显式指定，避免数据写到包目录或容器临时层
#   （providers.json 会落盘到该目录的「父目录」，与 sessions 平级）
# Docker 镜像内默认为 /data，npm 包用户可设为 ~/.duet 等
# DATA_DIR=/data

# 全局硬熔断（防止无限对话烧钱；会话级 maxRounds/durationSec 留空=无限，但仍受此兜底）
ABSOLUTE_MAX_ROUNDS=200
ABSOLUTE_MAX_DURATION_SEC=7200

# 单次 AI 调用超时（毫秒）
REQUEST_TIMEOUT_MS=30000
