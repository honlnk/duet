DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 服务端口（0 = 自动分配可用端口）
PORT=3000

# 会话数据持久化目录
# - 开发 / 源码部署：留空则使用 项目根/data/sessions
# - npm 包 / Docker：建议显式指定，避免数据写到包目录或容器临时层
# Docker 镜像内默认为 /data，npm 包用户可设为 ~/.duet 等
# DATA_DIR=/data

# 全局硬熔断（防止无限对话烧钱）
ABSOLUTE_MAX_ROUNDS=200
ABSOLUTE_MAX_DURATION_SEC=7200

# 单次 AI 调用超时（毫秒）
REQUEST_TIMEOUT_MS=30000

# DeepSeek 估算单价（美元/百万 token，仅供参考成本展示）
COST_INPUT_PER_MTOK=0.27
COST_OUTPUT_PER_MTOK=1.10
